(ns atc-support.facts
  "The ATC administrative support actor's whole vocabulary: the four ops
  the advisor may propose, each with the meaning README.md documents for
  it. Read by `atc-support.governor`: an op outside `permitted-ops` is
  held as `:unknown-op`, so the governor judges only proposals it has
  rules for.

  Why a closed list: `llm-advisor` passes through whatever `:op` the model
  returns, and its parse-failure proposal is `:op :unknown`. Before this
  file the governor held only the ops `disallowed-ops` names, so any other
  keyword -- e.g. `:issue-notam`, an aeronautical-information authority act
  and not administrative support -- reached `:commit` at high confidence
  (measured 2026-09-25 against 31d1b89: `governor_test` and `actor_test`
  `...outside-vocabulary` were red before the governor read this file).

  No external source is cited here: these are this actor's own
  definitions, not facts about the world.")

(def op-descriptions
  {:log-shift-handover-note         "record a post-shift handover note for the incoming controller"
   :draft-training-record           "draft a controller training record for review"
   :flag-equipment-anomaly          "surface a facility equipment anomaly for human review (escalates)"
   :coordinate-facility-maintenance "propose a facility maintenance coordination item"})

(def permitted-ops (set (keys op-descriptions)))

(def escalating-ops
  "Ops that always need human sign-off, whatever the advisor's confidence."
  #{:flag-equipment-anomaly})
